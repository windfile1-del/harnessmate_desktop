{
  "id": "hm.plugin.chat-lite",
  "name": "Chat Lite",
  "version": "1.0.0",
  "apiVersion": 4,
  "engines": { "pluginApi": "^4.0" },
  "permissions": ["storage:plugin"],
  "category": "ui",
  "main": "index.mjs",
  "provides": [
    "chat.view.v1"
  ],
  "contributes": {
    "slots": [
      {
        "slot": "workspace.pages",
        "id": "chat",
        "title": "Chat Lite",
        "ui": "ui/index.html"
      }
