{
  "$ref": "#/definitions/PluginManifestV4",
  "definitions": {
    "PluginManifestV4": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "default": "1.0.0"
        },
        "description": {
          "type": "string",
          "maxLength": 320
        },
        "author": {
          "type": "string",
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "enum": [
            "harness",
            "tool",
            "mcp",
            "telemetry",
            "ui",
            "remote",
            "workflow"
          ],
          "default": "workflow"
        },
        "apiVersion": {
          "type": "number",
          "const": 4
        },
        "engines": {
          "type": "object",
          "properties": {
            "pluginApi": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "required": [
            "pluginApi"
          ],
          "additionalProperties": false
        },
        "main": {
          "type": "string"
        },
        "inject": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "application.view.v1",
                  "chat.view.v1",
                  "browser.v1",
                  "filePreview.v1",
                  "approval.policy.v1",
                  "runtime.requests.v1",
                  "runtime.requests.view.v1",
                  "runtime.request-delivery.v1",
                  "history.source.v1",
                  "history.import.v1",
                  "session.search.v1",
                  "git.workspace.v1",
                  "git.checkpoint.v1",
                  "terminal.workspace.v1",
                  "terminal.runner.v1",
                  "workspace.files.v1",
                  "session.attachments.v1",
                  "workspace.rules.v1",
                  "harness.usage.v1",
                  "harness.model-catalog.v1",
                  "session.failover.v1",
                  "harness.mcp-config.v1",
                  "session.model-tools.v1",
                  "session.data.v1",
                  "session.runtime.v1",
                  "hm.session-data.v1",
                  "harness.driver.v1",
                  "harness.driver.codex.v1",
                  "harness.driver.claude.v1",
                  "harness.driver.acp.v1",
                  "harness.driver.agy.v1",
                  "session.handoff.v1",
                  "session.compression.v1",
                  "session.collaboration.v1",
                  "session.orchestration.v1",
                  "agy.runtime.v1",
                  "agy.accounts.v1",
                  "agy.workbench.v1"
                ]
              },
              {
                "type": "string",
                "maxLength": 100,
                "pattern": "^harness\\.driver\\.[a-z0-9][a-z0-9._-]{0,47}\\.v1$"
              },
              {
                "type": "string",
                "maxLength": 100,
                "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*$"
              }
            ]
          },
          "maxItems": 32
        },
        "optional": {
          "$ref": "#/definitions/PluginManifestV4/properties/inject"
        },
        "provides": {
          "$ref": "#/definitions/PluginManifestV4/properties/inject"
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "contract": {
                "$ref": "#/definitions/PluginManifestV4/properties/inject/items"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "optional": {
                "type": "boolean"
              }
            },
            "required": [
              "contract"
            ],
            "additionalProperties": false
          },
          "propertyNames": {
            "minLength": 1,
            "maxLength": 64
          }
        },
        "startPage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "activationEvents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "maxItems": 32
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260
          },
          "maxItems": 64
        },
        "contributes": {
          "type": "object",
          "properties": {
            "harnesses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 48,
                    "pattern": "^[a-z0-9][a-z0-9_-]*$"
                  },
                  "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 240,
                    "default": "Custom ACP CLI Harness"
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": [
                      "acp",
                      "--stdio"
                    ]
                  },
                  "env": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "id",
                  "displayName",
                  "command"
                ],
                "additionalProperties": false
              }
            },
            "slashCommands": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40,
                    "pattern": "^[a-z0-9][a-z0-9_-]*$"
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "template": {
                    "type": "string",
                    "minLength": 1
                  },
                  "argumentHint": {
                    "type": "string",
                    "maxLength": 80
                  }
                },
                "required": [
                  "command",
                  "description",
                  "template"
                ],
                "additionalProperties": false
              }
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40,
                    "pattern": "^[a-z0-9][a-z0-9_-]*$"
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 160
                  },
                  "argumentHint": {
                    "type": "string",
                    "maxLength": 80
                  }
                },
                "required": [
                  "command",
                  "description"
                ],
                "additionalProperties": false
              },
              "maxItems": 24
            },
            "mcpPresets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "transport": {
                    "type": "string",
                    "enum": [
                      "stdio",
                      "http",
                      "sse"
                    ]
                  },
                  "command": {
                    "type": "string"
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "url": {
                    "type": "string"
                  },
                  "env": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "name",
                  "description",
                  "transport"
                ],
                "additionalProperties": false
              }
            },
            "panels": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "sections": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "turns",
                        "changed_files",
                        "verifications",
                        "recent_activity"
                      ]
                    },
                    "maxItems": 4,
                    "default": []
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 48
                        },
                        "command": {
                          "$ref": "#/definitions/PluginManifestV4/properties/contributes/properties/slashCommands/items/properties/command"
                        },
                        "args": {
                          "type": "string",
                          "maxLength": 240
                        }
                      },
                      "required": [
                        "label",
                        "command"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 6,
                    "default": []
                  }
                },
                "required": [
                  "id",
                  "title"
                ],
                "additionalProperties": false
              },
              "maxItems": 6
            },
            "projections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
                  },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "session",
                      "workspace"
                    ]
                  },
                  "events": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "turn.completed",
                        "turn.failed",
                        "turn.cancelled"
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 3
                  }
                },
                "required": [
                  "id",
                  "scope",
                  "events"
                ],
                "additionalProperties": false
              },
              "maxItems": 6
            },
            "dataPanels": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/PluginManifestV4/properties/contributes/properties/projections/items/properties/id"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "projection": {
                    "$ref": "#/definitions/PluginManifestV4/properties/contributes/properties/projections/items/properties/id"
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string",
                          "enum": [
                            "time",
                            "session",
                            "harness",
                            "status",
                            "changed_files",
                            "verifications"
                          ]
                        },
                        "label": {
                          "$ref": "#/definitions/PluginManifestV4/properties/contributes/properties/dataPanels/items/properties/title"
                        }
                      },
                      "required": [
                        "field",
                        "label"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 6
                  },
                  "filters": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "harness",
                        "status"
                      ]
                    },
                    "maxItems": 2
                  },
                  "defaultEvent": {
                    "$ref": "#/definitions/PluginManifestV4/properties/contributes/properties/projections/items/properties/events/items"
                  },
                  "counts": {
                    "type": "boolean"
                  },
                  "openTurn": {
                    "type": "boolean"
                  },
                  "placements": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "sidebar_tool",
                        "composer_action"
                      ]
                    },
                    "maxItems": 2
                  },
                  "copySummary": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "$ref": "#/definitions/PluginManifestV4/properties/contributes/properties/dataPanels/items/properties/title"
                      },
                      "command": {
                        "$ref": "#/definitions/PluginManifestV4/properties/contributes/properties/projections/items/properties/id"
                      }
                    },
                    "required": [
                      "label"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "id",
                  "title",
                  "projection",
                  "columns"
                ],
                "additionalProperties": false
              },
              "maxItems": 6
            },
            "programs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/PluginManifestV4/properties/contributes/properties/projections/items/properties/id"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "op": {
                              "type": "string",
                              "const": "trim"
                            }
                          },
                          "required": [
                            "op"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "op": {
                              "type": "string",
                              "const": "case"
                            },
                            "mode": {
                              "type": "string",
                              "enum": [
                                "lower",
                                "upper"
                              ]
                            }
                          },
                          "required": [
                            "op",
                            "mode"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "op": {
                              "type": "string",
                              "const": "replace"
                            },
                            "find": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "replacement": {
                              "type": "string",
                              "maxLength": 256
                            }
                          },
                          "required": [
                            "op",
                            "find",
                            "replacement"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "op": {
                              "type": "string",
                              "const": "wrap"
                            },
                            "prefix": {
                              "type": "string",
                              "maxLength": 512
                            },
                            "suffix": {
                              "type": "string",
                              "maxLength": 512
                            }
                          },
                          "required": [
                            "op",
                            "prefix",
                            "suffix"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "op": {
                              "type": "string",
                              "const": "lines"
                            },
                            "contains": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "ignoreCase": {
                              "type": "boolean"
                            },
                            "unique": {
                              "type": "boolean"
                            },
                            "order": {
                              "type": "string",
                              "enum": [
                                "asc",
                                "desc"
                              ]
                            },
                            "limit": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 200
                            }
                          },
                          "required": [
                            "op"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 16
                  },
                  "exposeToModel": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "description",
                  "steps"
                ],
                "additionalProperties": false
              },
              "maxItems": 12
            },
            "actions": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "command": {
                        "$ref": "#/definitions/PluginManifestV4/properties/contributes/properties/projections/items/properties/id"
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "kind": {
                        "type": "string",
                        "const": "program"
                      },
                      "program": {
                        "$ref": "#/definitions/PluginManifestV4/properties/contributes/properties/projections/items/properties/id"
                      }
                    },
                    "required": [
                      "command",
                      "description",
                      "kind",
                      "program"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "command": {
                        "$ref": "#/definitions/PluginManifestV4/properties/contributes/properties/projections/items/properties/id"
                      },
                      "description": {
                        "$ref": "#/definitions/PluginManifestV4/properties/contributes/properties/actions/items/anyOf/0/properties/description"
                      },
                      "kind": {
                        "type": "string",
                        "const": "harness"
                      },
                      "nativeCommand": {
                        "type": "string",
                        "enum": [
                          "compact",
                          "usage",
                          "model",
                          "plan",
                          "goal",
                          "skills",
                          "skill"
                        ]
                      },
                      "args": {
                        "type": "string",
                        "maxLength": 2000
                      }
                    },
                    "required": [
                      "command",
                      "description",
                      "kind",
                      "nativeCommand"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "maxItems": 12
            },
            "slots": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slot": {
                    "type": "string",
                    "enum": [
                      "application.shell",
                      "workspace.pages",
                      "workspace.start",
                      "session.header.title",
                      "sidebar.tools",
                      "composer.actions",
                      "inspector.tabs",
                      "inspector.tab",
                      "statusbar.items",
                      "chat.node",
                      "tool.result",
                      "approval.detail",
                      "chat.message.wrapper",
                      "chat.block",
                      "composer.traits",
                      "harness.settings",
                      "inspector.diff",
                      "inspector.files",
                      "inspector.rules",
                      "session.stage.embedded",
                      "session.sidebar.badge"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "ui": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "module": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "mountMode": {
                    "type": "string",
                    "enum": [
                      "iframe",
                      "trusted-module"
                    ]
                  },
                  "when": {
                    "type": "object",
                    "properties": {
                      "harnessKinds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40
                        },
                        "minItems": 1,
                        "maxItems": 16
                      }
                    },
                    "additionalProperties": false
                  },
                  "order": {
                    "type": "integer",
                    "minimum": -1000,
                    "maximum": 1000
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 48,
                    "maximum": 1200
                  }
                },
                "required": [
                  "slot",
                  "id",
                  "title",
                  "ui"
                ],
                "additionalProperties": false
              },
              "maxItems": 12
            },
            "filePreview": {
              "type": "object",
              "properties": {
                "extensions": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "*"
                      },
                      {
                        "type": "string",
                        "pattern": "^\\.[a-z0-9][a-z0-9_-]{0,15}$"
                      }
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 24
                },
                "viewerKind": {
                  "type": "string",
                  "enum": [
                    "text",
                    "markdown",
                    "custom"
                  ]
                }
              },
              "required": [
                "extensions"
              ],
              "additionalProperties": false
            },
            "settings": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "string",
                      "number",
                      "boolean",
                      "object",
                      "array"
                    ]
                  },
                  "default": {},
                  "description": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "volatile": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              }
            },
            "settingsVersion": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "uiSlots": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "sidebar_tool",
                  "inspector_tab",
                  "composer_action",
                  "modal"
                ]
              }
            },
            "hooks": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "before_turn",
                  "after_turn",
                  "on_event"
                ]
              }
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "apiVersion",
        "engines"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
