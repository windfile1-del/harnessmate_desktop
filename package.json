{
  "name": "harnessmate-desktop",
  "version": "0.6.0",
  "private": true,
  "description": "HarnessMate Desktop — Unified Multi-Harness Manager & Mobile Remote Hub",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:daemon": "pnpm --filter @harnessmate/daemon dev",
    "dev:web": "pnpm --filter @harnessmate/web dev",
    "dev:electron": "pnpm --filter @harnessmate/electron dev",
    "build": "pnpm -r build",
    "pack:exe": "pnpm build && pnpm --filter @harnessmate/electron pack:exe",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm contracts:check && pnpm -r --workspace-concurrency=1 test",
    "contracts:generate": "pnpm --filter @harnessmate/plugin-api build && node scripts/plugin-contracts.mjs",
    "contracts:check": "pnpm --filter @harnessmate/plugin-api build && node scripts/plugin-contracts.mjs --check",
    "create:plugin": "node scripts/create-plugin.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^3.1.1",
    "zod-to-json-schema": "^3.24.6"
  }
}
